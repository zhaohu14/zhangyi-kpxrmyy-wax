<van-field
    value="{{ idCard }}"
    required
    clearable
    label="身份证号"
    placeholder="请输入身份证号"
    bind:click-icon="onClickIcon"
    bind:change="changeCode"
    data-code="idCard"
/>
<van-field
    value="{{ nation }}"
    required
    readonly
    label="民族"
    placeholder="请选择民族"
>
    <van-button bind:tap="changShowPicker" data-type="nation" data-list="nationList" slot="button" size="small" type="info">
      点击选择民族
    </van-button>
</van-field>

<van-field
    value="{{ matrimony }}"
    required
    readonly
    label="婚姻状态"
    placeholder="请选择婚姻状态"
>
    <van-button bind:tap="changShowPicker" data-type="matrimony" data-list="matrimonyLsit" slot="button" size="small" type="info">
      点击选择婚姻状态
    </van-button>
</van-field>

<van-field
    value="{{ job }}"
    required
    readonly
    label="工作种类"
    placeholder="请选择工作种类"
>
    <van-button bind:tap="changShowPicker" data-type="job" data-list="jobList" slot="button" size="small" type="info">
      点击选择工作种类
    </van-button>
</van-field>

<van-field
    value="{{ rel }}"
    required
    readonly
    label="关系"
    placeholder="请选择该卡与本人关系"
>
    <van-button bind:tap="changShowPicker" data-type="rel" data-list="relList" slot="button" size="small" type="info">
      点击选择关系
    </van-button>
</van-field>

<van-field
    value="{{ mobile }}"
    required
    clearable
    label="手机号"
    placeholder="请输入手机号"
    bind:click-icon="onClickIcon"
    bind:change="changeCode"
    data-code="mobile"
/>

<van-field
    value="{{ address }}"
    required
    clearable
    label="住址"
    placeholder="请输入住址"
    bind:click-icon="onClickIcon"
    bind:change="changeCode"
    data-code="address"
/>

<view class="submitBtn">
    <van-button type="info" bind:tap="submitFunc">注册/绑定电子健康卡</van-button>
</view>

<van-popup show="{{ showPicker }}" bind:close="onClose" position="bottom">
    <van-picker columns="{{ pickerList }}" bind:change="onChange" value-key="value" show-toolbar="{{ true }}" bind:confirm="pickerChange" bind:cancel="pickerCancel"/>
</van-popup>


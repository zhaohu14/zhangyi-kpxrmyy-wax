<view class="header">
    <view class="headerContent">
        <view class="left">当前就诊人：{{ cardInfo.Name }}</view>
        <image class="cardImg" src="../../static/icon/card.png" mode=""/>
        <image src="../../static/icon/right.png" mode=""/>
    </view>
</view>

<view class="rows" wx:for="{{ list }}">
    <van-cell border="{{ false }}" title="{{ item.Dpt }}"></van-cell>
    <van-cell title="预约科室" value="{{ item.Dpt }}"></van-cell>
    <van-cell title="预约医生" value="{{ item.Dr }}"></van-cell>
    <!-- <van-cell title="预约类型" value="专家门诊"></van-cell> -->
    <van-cell title="就诊日期" value="{{ item.Time }}"></van-cell>
    <!-- <van-cell title="预约状态" value="待就诊"></van-cell> -->
    <view class="btn" bind:tap="toyyjfDetail" data-item="{{ item }}">查看详情</view>
    
</view>
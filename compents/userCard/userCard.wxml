<picker mode="selector" header-text="选择就诊卡" range="{{ cardList }}" range-key="Name" bindchange="changeCard">
  <view class="header">
    <view class="headerContent">
      <view class="left">当前就诊人：{{ cardInfo.Name }}</view>
      <image class="cardImg" src="../../static/icon/card.png" mode="" />
      <image src="../../static/icon/right.png" mode="" />
    </view>
  </view>
</picker>